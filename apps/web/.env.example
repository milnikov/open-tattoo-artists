# Supabase (auth, favourites, contributions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub: create issues for "Suggest artist" (server-only, keep secret)
# See apps/web/GITHUB_SETUP.md for how to create a token.
GITHUB_TOKEN=
GITHUB_REPO=

# Optional: used for "Report problem" and links (e.g. milnikov/open-tattoo-artists)
NEXT_PUBLIC_GITHUB_REPO=

# R2 public URL base for images (must match config.yaml r2.public_url)
# Example custom domain: https://img.example.com — or legacy https://pub-xxx.r2.dev
NEXT_PUBLIC_IMAGES_BASE_URL=
